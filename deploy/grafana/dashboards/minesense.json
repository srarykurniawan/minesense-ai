{
 "title": "MineSense AI",
 "uid": "minesense",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests/s per endpoint",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (path) (rate(minesense_requests_total[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latency p95 (s)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, path) (rate(minesense_request_latency_seconds_bucket[5m])))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Error rate 5xx",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum(rate(minesense_requests_total{status=~\"5..\"}[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Intent chat",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (intent) (increase(minesense_chat_intent_total[1h]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Grounded rate",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 6,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum(rate(minesense_chat_intent_total{grounded=\"True\"}[1h])) / sum(rate(minesense_chat_intent_total[1h]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "bargauge",
   "title": "Feedback (24 jam)",
   "gridPos": {
    "x": 6,
    "y": 16,
    "w": 6,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (rating) (increase(minesense_feedback_total[1d]))",
     "refId": "A"
    }
   ]
  }
 ]
}