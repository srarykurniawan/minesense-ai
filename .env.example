# ===== MineSense AI — konfigurasi (salin ke .env) =====
MINESENSE_ENV=prod
# Wajib di produksi: daftar API key dipisah koma. Buat: python -c "import secrets;print(secrets.token_urlsafe(32))"
MINESENSE_API_KEYS=ganti-dengan-key-acak
MINESENSE_UI_API_KEY=ganti-dengan-key-acak   # salah satu dari MINESENSE_API_KEYS, dipakai UI
MINESENSE_RATE_LIMIT_PER_MINUTE=60
MINESENSE_CORS_ORIGINS=https://minesense.perusahaan.co.id

# ----- LLM: extractive | anthropic | openai | ollama -----
MINESENSE_LLM_PROVIDER=extractive
# Contoh Claude:
# MINESENSE_LLM_PROVIDER=anthropic
# MINESENSE_LLM_MODEL=claude-sonnet-4-5
# MINESENSE_LLM_API_KEY=sk-ant-...
# Contoh model fine-tune lokal via Ollama (docker compose --profile ollama):
# MINESENSE_LLM_PROVIDER=ollama
# MINESENSE_LLM_MODEL=minesense
# MINESENSE_LLM_BASE_URL=http://ollama:11434/v1
# Contoh vLLM / OpenAI-compatible:
# MINESENSE_LLM_PROVIDER=openai
# MINESENSE_LLM_BASE_URL=http://vllm:8000/v1
# MINESENSE_LLM_MODEL=minesense-qwen15b

# ----- Retrieval -----
MINESENSE_EMBEDDING_BACKEND=hashing        # hashing | sentence-transformers | openai
# MINESENSE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MINESENSE_VECTOR_BACKEND=memory            # memory | qdrant
MINESENSE_TOP_K=5
MINESENSE_RERANKER=none                    # none | cross-encoder (butuh extra [neural])

# ----- Classifier -----
MINESENSE_CLASSIFIER_BACKEND=sklearn       # sklearn | transformers

# ----- Deploy (Caddy / compose) -----
DOMAIN=minesense.perusahaan.co.id
UI_BASIC_AUTH_USER=admin
UI_BASIC_AUTH_HASH=$$2a$$14$$ganti_dengan_hasil_caddy_hash-password
IMAGE_PREFIX=minesense
IMAGE_TAG=latest
GRAFANA_PASSWORD=ganti-password
